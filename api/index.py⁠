import os
import re
import requests
from flask import Flask, request

app = Flask(__name__)

TOKEN = os.environ.get("BOT_TOKEN")
TELEGRAM_API = f"https://api.telegram.org/bot{TOKEN}"


def get_olx_images(url):
    headers = {
        "User-Agent": "Mozilla/5.0"
    }

    try:
        r = requests.get(url, headers=headers, timeout=10)

        if r.status_code != 200:
            return []

        pattern = r'https://[a-zA-Z0-9\.\-]+/v1/files/[a-zA-Z0-9\-]+/image[^\s"\'<>]*'
        urls = re.findall(pattern, r.text)

        return list(set(u.split(";")[0] for u in urls))

    except Exception:
        return []


def send_message(chat_id, text):
    requests.post(
        f"{TELEGRAM_API}/sendMessage",
        json={
            "chat_id": chat_id,
            "text": text
        }
    )


def send_media_group(chat_id, images):
    for i in range(0, len(images), 10):
        media = [
            {"type": "photo", "media": img}
            for img in images[i:i + 10]
        ]

        requests.post(
            f"{TELEGRAM_API}/sendMediaGroup",
            json={
                "chat_id": chat_id,
                "media": media
            }
        )


@app.route("/", methods=["GET"])
def home():
    return "Bot ishlayapti!"


@app.route("/api/index", methods=["GET", "POST"])
def telegram_webhook():
    if request.method == "GET":
        return "OK"

    try:
        update = request.get_json()

        if "message" in update and "text" in update["message"]:
            chat_id = update["message"]["chat"]["id"]
            text = update["message"]["text"].strip()

            if text == "/start":
                send_message(
                    chat_id,
                    "Assalomu alaykum! Menga OLX e'lon havolasini yuboring."
                )

            elif "olx.uz" in text:
                send_message(
                    chat_id,
                    "Rasmlar qidirilmoqda, biroz kuting..."
                )

                images = get_olx_images(text)

                if images:
                    send_media_group(chat_id, images)
                else:
                    send_message(
                        chat_id,
                        "Rasmlarni yuklab bo'lmadi."
                    )

            else:
                send_message(
                    chat_id,
                    "Iltimos, OLX.uz havolasini yuboring."
                )

        return "OK", 200

    except Exception:
        return "OK", 200
